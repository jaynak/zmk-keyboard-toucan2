#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            layers = <0>;
        };

        combo_lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <15 16>;
            layers = <0>;
        };

        combo_lpar {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <27 28>;
            layers = <0>;
        };

        combo_rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
            layers = <0>;
        };

        combo_rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
            layers = <0>;
        };

        combo_rpar {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <31 32>;
            layers = <0>;
        };

        combo_langle {
            bindings = <&kp LESS_THAN>;
            key-positions = <13 14>;
            layers = <0>;
        };

        combo_rangle {
            bindings = <&kp GREATER_THAN>;
            key-positions = <21 22>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp ESC    &kp Q        &kp W       &kp F        &kp P       &kp B          &kp J        &kp L            &kp U                &kp Y            &kp SEMICOLON  &kp MINUS
&kp GRAVE  &hml LSHFT A  &hml LALT R  &hml LCTRL S  &hml LGUI T  &kp G          &kp M        &hmr RGUI N       &hmr RIGHT_CONTROL E  &hmr RIGHT_ALT I  &hmr RSHFT O    &kp APOSTROPHE
&kp LCTRL  &kp Z        &kp X       &kp C        &kp D       &kp V          &kp K        &kp H            &kp COMMA            &kp DOT          &kp FSLH       &kp BACKSLASH
                                    &kp LGUI     &lt 2 TAB   &lt 1 SPACE    &lt 1 ENTER  &bspc_lt 2 BACKSPACE  &kp RALT
            >;
        };

        sym_num_layer {
            display-name = "SYM";
            bindings = <
&trans   &trans  &kp AMPERSAND    &kp ASTERISK  &kp GRAVE  &trans    &kp MINUS     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH     &trans
&trans   &trans  &kp DOLLAR       &kp PERCENT   &kp CARET  &trans    &kp PLUS      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &trans
&trans   &trans  &kp EXCLAMATION  &kp AT        &kp HASH   &trans    &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL     &trans
                                  &trans        &trans     &trans    &trans        &trans        &trans
            >;
        };

        brd_sym_layer {
            display-name = "FUN";
            bindings = <
&trans          &bt BT_CLR  &kp F7  &kp F8  &kp F9  &kp F12    &kp PAGE_UP    &kp HOME      &kp UP_ARROW    &kp END        &kp C_VOLUME_UP    &kp C_MUTE
&trans          &bt BT_NXT  &kp F4  &kp F5  &kp F6  &kp F11    &kp PAGE_DOWN  &kp LEFT      &kp DOWN        &kp RIGHT      &kp C_VOLUME_DOWN  &trans
&studio_unlock  &bt BT_PRV  &kp F1  &kp F2  &kp F3  &kp F10    &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3   &bt BT_SEL 4       &kp LG(LS(LC(N4)))
                            &trans  &trans  &trans    &kp C_BRIGHTNESS_DEC     &trans        &kp C_BRIGHTNESS_INC
            >;
        };

        // Spare layer for ZMK Studio. Index 3 is kept reserved so the mouse
        // layer lands on index 4, which the trackpad processors expect.
        extra_3 {
            status = "reserved";
        };

        // Toucan-only: auto-activated (&mo 4 in toucan.dtsi) while the trackpad
        // is touched, so the thumb keys become mouse buttons.
        mouse_layer {
            display-name = "MOU";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                     &mkp MCLK &mkp LCLK &mkp RCLK    &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        // Spare layer for ZMK Studio
        extra_5 {
            status = "reserved";
        };
    };

    behaviors {
        // Timeless home row mods: a mod only becomes a hold when the next key
        // is on the opposite hand; same-hand keys resolve it as a tap.
        hml: home_row_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS_LEFT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MODS_RIGHT";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        bspc_lt: backspace_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>; // Tap then hold within this window = held (repeating) backspace
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };
};
